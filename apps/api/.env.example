# Point to the SQLite file you populated in DB Browser. Use an absolute path.
# Windows example: DATABASE_PATH=C:/Users/YourName/Documents/FootballGame/football.sqlite
# Blank uses %LOCALAPPDATA%/FootballGame/data/football.sqlite on Windows.
DATABASE_PATH=
# Optional: defaults to the newest season in the single imported league.
# Set these explicitly when the database contains multiple leagues/seasons.
LEAGUE_ID=
SEASON_ID=

# Optional awards AI. Keys stay on the server. Google Sheets credentials are not used.
GEMINI_API_KEY=
GEMINI_AWARDS_MODEL=gemini-2.5-flash
PORT=4000
