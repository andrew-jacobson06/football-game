# SQLite foundation. Leave blank for the platform's local application-data directory.
# Windows default: %LOCALAPPDATA%/FootballGame/data/football.sqlite
# Use an absolute path for a custom location; dotenv does not expand %VARIABLE% text.
DATABASE_PATH=

# Current application still uses Sheets until the storage migration is completed.
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=secrets/service-account.json

# Optional awards AI. Keys stay on the server.
GEMINI_API_KEY=
GEMINI_AWARDS_MODEL=gemini-2.5-flash
PORT=4000
